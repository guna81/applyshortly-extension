{
  "name": "applyshortly-extension",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test extension/test/*.test.mjs",
    "typecheck": "tsc -p extension-bridge/tsconfig.json && tsc -p tsconfig.extension.json",
    "test:packaging": "python3 -m unittest discover -s scripts -p 'test_build_extension.py'",
    "check": "npm test && npm run typecheck && npm run test:packaging",
    "build": "python3 scripts/build_extension.py",
    "build:source": "python3 scripts/build_extension.py --source"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  }
}
