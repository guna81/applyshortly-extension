{
  "version": 1,
  "html": "<!doctype html><title>Executor contract</title><form onsubmit='window.submissions++; return false'><label>First name<input id='first' name='first' required></label><label>Country of residence<select id='country' name='country' required><option value=''>Choose</option><option>India</option><option>Canada</option></select></label><label><input id='consent' type='checkbox'>Privacy consent</label><label>Phone<input id='phone' type='tel'></label><label>Masked number<input id='masked' inputmode='numeric' oninput=\"this.value=this.value.replace(/[^0-9]/g,'').replace(/(\\d{3})(?=\\d)/g,'$1-')\"></label><label>Password<input id='secret' type='password'></label><label>Resume<input id='resume' type='file'></label><button type='submit'>Submit application</button></form><script>window.submissions=0;</script>",
