{
  "manifest_version": 3,
  "name": "Apply Shortly Form Assistant",
  "version": "0.4.0",
  "description": "Fills job applications from your ApplyShortly profile and answers, even multi-step forms. Submits only when you choose Auto apply.",
  "minimum_chrome_version": "125",
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage", "scripting", "activeTab", "identity", "debugger"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/fill.js", "src/panel-model.js", "src/panel-view.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Apply Shortly Form Assistant", "default_popup": "src/popup.html", "default_icon": "icons/icon-48.png" },
  "commands": {
    "autofill": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Autofill this page" }
  },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
