{
  "manifest_version": 3,
  "name": "ApplyShortly Form Assisstant",
  "version": "0.4.2",
  "description": "Fills multi-step job applications from your ApplyShortly profile and answers. Submits only when you choose Auto apply.",
  "minimum_chrome_version": "125",
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage", "scripting", "activeTab", "identity", "debugger", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/page-control/phone.js", "src/rule-based/profile-answer.js", "src/rule-based/answers.js", "src/page-control/dom.js", "src/shared/ui/panel-model.js", "src/shared/ui/panel-view.js", "src/shared/ui/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "src/ui/popup.html", "default_title": "ApplyShortly Form Assisstant", "default_icon": "icons/icon-48.png" },
  "commands": {
    "autofill": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Autofill this page" }
  },
  "options_ui": { "page": "src/ui/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
